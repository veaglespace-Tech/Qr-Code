NODE_ENV=development
PORT=5000

DATABASE_URL="mysql://root:password@localhost:3306/review_express"
CLIENT_URL="http://localhost:3000"
CLIENT_ORIGINS="http://localhost:3000"

JWT_KEY=your_jwt_secret_key_here
JWT_SECRET=your_jwt_secret_key_here

# ==============================================================================
# Payment Gateway (PayU India)
# Set PAYU_MODE=test for sandbox, or PAYU_MODE=live for production
# When PAYU_MODE=live, it automatically connects to https://secure.payu.in/_payment
# When PAYU_MODE=test, it connects to https://test.payu.in/_payment
# ==============================================================================
PAYU_MODE=test

# --- Sandbox / Test Credentials ---
PAYU_TEST_KEY=GKJE3Z
PAYU_TEST_SALT=0zqiCnB4GslxAanSxjEAutWkWuggFiGs

# --- Production / Live Credentials (Fill when going live) ---
PAYU_LIVE_KEY=
PAYU_LIVE_SALT=

# --- Universal Fallbacks (Compatible with standard merchant names) ---
PAYU_MERCHANT_KEY=GKJE3Z
PAYU_MERCHANT_SALT=0zqiCnB4GslxAanSxjEAutWkWuggFiGs
PAYU_BASE_URL=https://test.payu.in/_payment

SERVER_BASE_URL=http://localhost:5000

# Email (SMTP / Nodemailer)
EMAIL=your_email@gmail.com
EMAIL_PASS=your_app_password

# ImageKit CDN & Uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
